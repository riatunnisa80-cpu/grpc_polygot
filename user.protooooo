
syntax = "proto3";

package user;

option go_package = "./pb";

message UserRequest {
  int32 user_id = 1;
}

message UserResponse {
option go_package = "grpc-polyglot-lab/pb";

  string name = 1;
  string email = 2;
}

service UserService {
  rpc GetUserProfile(UserRequest) returns (UserResponse);
}
